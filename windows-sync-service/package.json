{
  "name": "navalady-hikvision-sync-service",
  "version": "1.0.0",
  "description": "Standalone Windows Desktop Sync Service for Hikvision DS-K1A8503MF Biometric Terminals to Nava Lady HRM & Supabase",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "dev": "ts-node src/index.ts",
    "build:exe": "tsc && pkg dist/index.js --targets node18-win-x64 --output dist/NavaLady-Hikvision-Sync.exe",
    "install:service": "node scripts/install-windows-service.js",
    "uninstall:service": "node scripts/uninstall-windows-service.js"
  },
  "keywords": [
    "hikvision",
    "isapi",
    "biometric",
    "attendance",
    "ds-k1a8503mf",
    "supabase",
    "windows-service",
    "tray"
  ],
  "author": "Nava Lady HR Solutions",
  "license": "Proprietary",
  "dependencies": {
    "axios": "^1.7.0",
    "digest-fetch": "^3.0.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "systray2": "^2.1.2",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/node-cron": "^3.0.11",
    "pkg": "^5.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
